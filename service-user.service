[Unit]
Description=Service User gRPC Service
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=service-user
Group=service-user
ExecStart=/usr/local/bin/service-user --config /etc/service-user/config.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=service-user

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/service-user

# Resource limits
LimitNOFILE=65536

# Environment file (optional)
# EnvironmentFile=-/etc/service-user/service-user.conf

[Install]
WantedBy=multi-user.target